c870 (\ubaa9\uc801) \ubcf8 \uc57d\uad00\uc740 AllEat(\uc774\ud558 \"\ud68c\uc0ac\")\uac00 \uc81c\uacf5\ud558\ub294 \ud398\uc774\uba38\ub2c8 \uc11c\ube44\uc2a4(\uc774\ud558 \"\uc11c\ube44\uc2a4\")\uc758 \uc774\uc6a9\uacfc \uad00\ub828\ud558\uc5ec \ud68c\uc0ac\uc640 \uc774\uc6a9\uc790 \uac04\uc758 \uad8c\ub9ac, \uc758\ubb34 \ubc0f \ucc45\uc784\uc0ac\ud56d\uc744 \uaddc\uc815\ud568\uc744 \ubaa9\uc801\uc73c\ub85c \ud569\ub2c8\ub2e4.","\n\n","\uc81c 2 \uc870 (\uc815\uc758)","\n","\"\ud398\uc774\uba38\ub2c8\"\ub780 \uc774\uc6a9\uc790\uac00 AllEat \uc11c\ube44\uc2a4 \ub0b4\uc5d0\uc11c \uc2dd\ube44 \uad00\ub9ac\ub97c \uc704\ud574 \uc0ac\uc6a9\ud558\ub294 \uac00\uc0c1\uc758 \uacc4\uc88c \ubc0f \uacb0\uc81c \uc218\ub2e8\uc744 \uc758\ubbf8\ud569\ub2c8\ub2e4.","\n","\"\uc774\uc6a9\uc790\"\ub780 AllEat \uc11c\ube44\uc2a4\uc5d0 \ud68c\uc6d0\uac00\uc785\ud558\uace0, \ubcf8 \uc57d\uad00\uc5d0 \ub3d9\uc758\ud55c \ud6c4 \ud398\uc774\uba38\ub2c8 \uacc4\uc88c\ub97c \uac1c\uc124\ud55c \uc790\ub97c \uc758\ubbf8\ud569\ub2c8\ub2e4.","\n","\"\ucda9\uc804\"\uc774\ub780 \uc774\uc6a9\uc790\uac00 \uc790\uc2e0\uc758 \ud398\uc774\uba38\ub2c8 \uacc4\uc88c\uc5d0 \uc790\uae08\uc744 \uc785\uae08\ud558\ub294 \ud589\uc704\ub97c \uc758\ubbf8\ud569\ub2c8\ub2e4.","\n","\"\uc1a1\uae08\"\uc774\ub780 \uc774\uc6a9\uc790\uac00 \uc790\uc2e0\uc758 \ud398\uc774\uba38\ub2c8 \uacc4\uc88c\uc5d0\uc11c \ub2e4\ub978 \uc774\uc6a9\uc790\uc5d0\uac8c \uc790\uae08\uc744 \uc774\uccb4\ud558\ub294 \ud589\uc704\ub97c \uc758\ubbf8\ud569\ub2c8\ub2e4.","\n\n","\uc81c 3 \uc870 (\uc57d\uad00\uc758 \ud6a8\ub825 \ubc0f \ubcc0\uacbd)","\n","\ubcf8 \uc57d\uad00\uc740 \uc774\uc6a9\uc790\uac00 \ud68c\uc6d0\uac00\uc785 \uc2dc \ub3d9\uc758\ud568\uc73c\ub85c\uc368 \ud6a8\ub825\uc774 \ubc1c\uc0dd\ud569\ub2c8\ub2e4.","\n","\ud68c\uc0ac\ub294 \uad00\ub828 \ubc95\ub839\uc744 \uc704\ubc30\ud558\uc9c0 \uc54a\ub294 \ubc94\uc704 \ub0b4\uc5d0\uc11c \uc57d\uad00\uc744 \uac1c\uc815\ud560 \uc218 \uc788\uc73c\uba70, \uac1c\uc815\ub41c \uc57d\uad00\uc740 \uc11c\ube44\uc2a4 \ub0b4\uc5d0 \uacf5\uc9c0\ud568\uc73c\ub85c\uc368 \ud6a8\ub825\uc774 \ubc1c\uc0dd\ud569\ub2c8\ub2e4.","\n","\uc774\uc6a9\uc790\ub294 \ubcc0\uacbd\ub41c \uc57d\uad00\uc5d0 \ub3d9\uc758\ud558\uc9c0 \uc54a\uc744 \uacbd\uc6b0, \ud68c\uc6d0 \ud0c8\ud1f4 \ubc0f \ud398\uc774\uba38\ub2c8 \uacc4\uc88c \ud574\uc9c0\ub97c \uc694\uccad\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.","\n\n","\uc81c 4 \uc870 (\ud398\uc774\uba38\ub2c8 \uacc4\uc88c \uac1c\uc124)","\n","\uc774\uc6a9\uc790\ub294 AllEat \uc11c\ube44\uc2a4 \ud68c\uc6d0\uac00\uc785 \uc2dc \ubcf8 \uc57d\uad00\uc5d0 \ub3d9\uc758\ud55c \ud6c4 \ud398\uc774\uba38\ub2c8 \uacc4\uc88c\ub97c \uac1c\uc124\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.","\n","\uacc4\uc88c \uac1c\uc124 \uc2dc \uc81c\uacf5\ud55c \uc815\ubcf4\ub294 \uc815\ud655\ud558\uace0 \uc0ac\uc2e4\uc774\uc5b4\uc57c \ud558\uba70, \uc798\ubabb\ub41c \uc815\ubcf4\ub85c \uc778\ud55c \ubd88\uc774\uc775\uc740 \uc774\uc6a9\uc790 \ubcf8\uc778\uc774 \ucc45\uc784\uc9d1\ub2c8\ub2e4.","\n\n","\uc81c 5 \uc870 (\ud398\uc774\uba38\ub2c8 \ucda9\uc804 \ubc0f \uc1a1\uae08)","\n","\uc774\uc6a9\uc790\ub294 \ud68c\uc0ac\uac00 \uc815\ud55c \ubc29\ubc95\uc744 \ud1b5\ud574 \uc790\uc2e0\uc758 \ud398\uc774\uba38\ub2c8 \uacc4\uc88c\uc5d0 \uc790\uae08\uc744 \ucda9\uc804\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.","\n","\ucda9\uc804\ub41c \uc790\uae08\uc740 AllEat \uc11c\ube44\uc2a4 \ub0b4\uc5d0\uc11c \uc2dd\ube44 \uacb0\uc81c \ubc0f \uad00\ub828 \uc11c\ube44\uc2a4 \uc774\uc6a9\uc5d0\ub9cc \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.","\n","\uc774\uc6a9\uc790\ub294 \uc790\uc2e0\uc758 \ud398\uc774\uba38\ub2c8 \uacc4\uc88c\uc5d0\uc11c \ub2e4\ub978 \uc774\uc6a9\uc790\uc5d0\uac8c \uc790\uae08\uc744 \uc1a1\uae08\ud560 \uc218 \uc788\uc73c\uba70, \uc774\ub54c \uc1a1\uae08 \ub0b4\uc5ed\uc740 AllEat \uc11c\ube44\uc2a4 \ub0b4\uc5d0\uc11c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.","\n\n","\uc81c 6 \uc870 (\ud398\uc774\uba38\ub2c8 \uc0ac\uc6a9 \uc81c\ud55c)","\n","\ud398\uc774\uba38\ub2c8\ub294 \uc624\ub85c\uc9c0 AllEat \uc11c\ube44\uc2a4 \ub0b4\uc5d0\uc11c \uc2dd\ube44 \uad00\ub828 \uacb0\uc81c\uc5d0\ub9cc \uc0ac\uc6a9\ud560 \uc218 \uc788\uc73c\uba70, \ub2e4\ub978 \uc6a9\ub3c4\ub85c \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.","\n","\uc774\uc6a9\uc790\ub294 \ud398\uc774\uba38\ub2c8 \uacc4\uc88c\ub97c \ud0c0\uc778\uc5d0\uac8c \uc591\ub3c4\ud558\uac70\ub098, \ub2f4\ubcf4\ub85c \uc81c\uacf5\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.","\n\n","\uc81c 7 \uc870 (\ud658\ubd88 \ubc0f \uacc4\uc88c \ud574\uc9c0)","\n","\ucda9\uc804\ub41c \ud398\uc774\uba38\ub2c8 \uc794\uc561\uc5d0 \ub300\ud55c \ud658\ubd88\uc740 \ud68c\uc0ac\uac00 \uc815\ud55c \uc808\ucc28\uc5d0 \ub530\ub77c \uc2e0\uccad\ud560 \uc218 \uc788\uc73c\uba70, \uc77c\uc815 \uc218\uc218\ub8cc\uac00 \ubd80\uacfc\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.","\n","\uc774\uc6a9\uc790\uac00 \ud68c\uc6d0 \ud0c8\ud1f4\ub97c \uc2e0\uccad\ud558\uac70\ub098 \ud398\uc774\uba38\ub2c8 \uacc4\uc88c \ud574\uc9c0\ub97c \uc694\uccad\ud560 \uacbd\uc6b0, \uc794\uc561\uc740 \ud658\ubd88 \uc808\ucc28\ub97c \uac70\uccd0 \ubc18\ud658\ub429\ub2c8\ub2e4.","\n\n","\uc81c 8 \uc870 (\uc774\uc6a9\uc790\uc758 \uc758\ubb34)","\n","\uc774\uc6a9\uc790\ub294 \uc11c\ube44\uc2a4 \uc774\uc6a9 \uc2dc \ubc95\ub839\uacfc \ubcf8 \uc57d\uad00, \ud68c\uc0ac\uc758 \uc815\ucc45\uc744 \uc900\uc218\ud574\uc57c \ud569\ub2c8\ub2e4.","\n","\uc774\uc6a9\uc790\ub294 \uc790\uc2e0\uc758 \uacc4\uc815 \ubc0f \ud398\uc774\uba38\ub2c8 \uacc4\uc88c \uc815\ubcf4\ub97c \uc548\uc804\ud558\uac8c \uad00\ub9ac\ud574\uc57c \ud558\uba70, \uc81c3\uc790\uc5d0\uac8c \uacf5\uc720\ud574\uc11c\ub294 \uc548 \ub429\ub2c8\ub2e4.","\n\n","\uc81c 9 \uc870 (\ud68c\uc0ac\uc758 \uc758\ubb34)","\n","\ud68c\uc0ac\ub294 \uad00\ub828 \ubc95\ub839\uacfc \ubcf8 \uc57d\uad00\uc5d0 \ub530\ub77c \uc11c\ube44\uc2a4\ub97c \uc131\uc2e4\ud788 \uc81c\uacf5\ud560 \uc758\ubb34\uac00 \uc788\uc2b5\ub2c8\ub2e4.","\n","\ud68c\uc0ac\ub294 \uc774\uc6a9\uc790\uc758 \uac1c\uc778\uc815\ubcf4\ub97c \ubcf4\ud638\ud558\uba70, \uad00\ub828 \ubc95\ub839\uc5d0 \ub530\ub77c \uc801\uc808\ud55c \ubcf4\uc548 \uc870\uce58\ub97c \ucde8\ud569\ub2c8\ub2e4.","\n\n","\uc81c 10 \uc870 (\uba74\ucc45 \uc870\ud56d)","\n","\ud68c\uc0ac\ub294 \ucc9c\uc7ac\uc9c0\ubcc0, \uc804\uc7c1, \uae30\ud0c0 \ubd88\uac00\ud56d\ub825\uc801\uc778 \uc0ac\uc720\ub85c \uc778\ud558\uc5ec \uc11c\ube44\uc2a4\ub97c \uc81c\uacf5\ud560 \uc218 \uc5c6\ub294 \uacbd\uc6b0, \uc774\uc5d0 \ub300\ud55c \ucc45\uc784\uc744 \uc9c0\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.","\n","\uc774\uc6a9\uc790\uc758 \uace0\uc758 \ub610\ub294 \uacfc\uc2e4\ub85c \uc778\ud574 \ubc1c\uc0dd\ud55c \uc190\ud574\uc5d0 \ub300\ud574\uc11c\ub294 \ud68c\uc0ac\uac00 \ucc45\uc784\uc9c0\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.","\n\n","\uc81c 11 \uc870 (\ubd84\uc7c1 \ud574\uacb0) \ubcf8 \uc57d\uad00\uacfc \uad00\ub828\ud558\uc5ec \ubc1c\uc0dd\ud55c \ubd84\uc7c1\uc740 \ud68c\uc0ac\uc758 \ubcf8\uc0ac \uc18c\uc7ac\uc9c0 \uad00\ud560 \ubc95\uc6d0\uc5d0\uc11c \ud574\uacb0\ud569\ub2c8\ub2e4.","\n\n"]})})}),(0,a.jsxs)(l.View,{style:_r(d[11]).styles.bottomContainer,children:[(0,a.jsxs)(l.View,{style:_r(d[11]).styles.checkboxContainer,children:[(0,a.jsx)(l.TouchableOpacity,{onPress:function(){f(!u)},style:_r(d[11]).styles.checkbox,children:u?(0,a.jsx)(_r(d[12]).icons.passwordCheck,{width:25,height:25}):(0,a.jsx)(_r(d[12]).icons.emptyCheck,{width:25,height:25})}),(0,a.jsx)(l.Text,{style:_r(d[11]).styles.checkboxText,children:"\uc774\uc6a9\uc57d\uad00\uc5d0 \ub3d9\uc758\ud569\ub2c8\ub2e4"})]}),(0,a.jsx)(r.default,{title:"\uacc4\uc18d\ud558\uae30",handlePress:y,containerStyles:"w-[100%] h-[60px]",textStyles:"text-white font-pbold",isLoading:!1})]})]})};_r(d[13]).NativeWindStyleSheet.create({styles:{container:{width:"100%"},"container@0":{maxWidth:640},"container@1":{maxWidth:768},"container@2":{maxWidth:1024},"container@3":{maxWidth:1280},"container@4":{maxWidth:1536},"h-[60px]":{height:60},"w-[100%]":{width:"100%"},"font-pbold":{fontFamily:"Pretendard-Bold"},"text-white":{color: